    {
      "name": "6. Verificación de encabezados de respuesta",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 200', () => pm.response.to.have.status(200));",
              "pm.test('Devuelve X-Servidor-Procesado', () => pm.expect(pm.response.headers.get('X-Servidor-Procesado')).to.eql('Equipo-' + pm.collectionVariables.get('N')));",
              "pm.test('CORS permite solo el origen definido', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql(pm.collectionVariables.get('origen')));",
              "pm.test('La respuesta es JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Red-Equipo",
            "value": "CIAF-{{N}}"
          },
          {
            "key": "Origin",
            "value": "{{origen}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/recurso",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "recurso"
          ]
        }
      },
      "response": []
    },
    {
      "name": "7. Preflight CORS (204)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 204', () => pm.response.to.have.status(204));",
              "pm.test('Permite X-Red-Equipo', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Headers')).to.include('X-Red-Equipo'));"
            ]
          }
        }
      ],
      "request": {
        "method": "OPTIONS",
        "header": [
          {
            "key": "Origin",
            "value": "{{origen}}"
          },
          {
            "key": "Access-Control-Request-Method",
            "value": "POST"
          },
          {
            "key": "Access-Control-Request-Headers",
            "value": "content-type,x-red-equipo"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/recurso",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "recurso"
          ]
        }
      },
      "response": []
    }
