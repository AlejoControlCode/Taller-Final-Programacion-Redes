{
  "info": {
    "name": "Taller final - Programación de redes",
    "description": "Pruebas de la API de envíos. La variable N debe coincidir con la constante N de server.js.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET válido (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 200', () => pm.response.to.have.status(200));",
              "pm.test('Devuelve X-Servidor-Procesado', () => pm.expect(pm.response.headers.get('X-Servidor-Procesado')).to.eql('Equipo-' + pm.collectionVariables.get('N')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Red-Equipo",
            "value": "CIAF-{{N}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/recurso",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "recurso"
          ]
        }
      },
      "response": []
    },
